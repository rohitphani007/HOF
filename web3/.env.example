# ============================================================
# PropFi India — Web3 Environment Variables
# ============================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# --- Polygon Amoy Testnet (free from Alchemy) ---
# Get it at: https://dashboard.alchemy.com → Create App → Polygon Amoy
ALCHEMY_AMOY_URL=https://polygon-amoy.g.alchemy.com/v2/

# --- Polygon Mainnet (if deploying to production) ---
ALCHEMY_POLYGON_URL=https://polygon-mainnet.g.alchemy.com/v2/

# --- Deployer Wallet ---
# Keep this MetaMask private key ONLY for this hackathon
# Get Amoy MATIC from: https://faucet.polygon.technology/
PRIVATE_KEY=

# --- Polygonscan (for contract verification) ---
# Get it at: https://polygonscan.com/myapikey
POLYGONSCAN_API_KEY=YOUR_POLYGONSCAN_API_KEY

# --- Gas Reporting ---
# REPORT_GAS=true




